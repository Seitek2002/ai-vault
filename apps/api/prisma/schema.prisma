generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
}

enum DocumentType {
  KP
  CONTRACT
  INVOICE_FACTURA
  INVOICE_PAYMENT
  AVR
  CUSTOM
}

enum DocumentStatus {
  DRAFT
  FINAL
  SENT
  SIGNED
}

enum ChangeType {
  INSERT
  DELETE
}

enum ChangeAuthor {
  AI
  USER
}

enum ChangeStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SettlementStepType {
  ISSUE_ACT
  ISSUE_INVOICE
  SEND
  ISSUE_ESF
  RECEIVE_SIGNED
  RECEIVE_PAYMENT
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users          User[]
  counterparties Counterparty[]
  documents      Document[]
  fileAssets     FileAsset[]
  templates      DocumentTemplate[]
  letterheads    Letterhead[]
  categories     DocumentCategory[]
  positions      Position[]
  settings       CompanySettings?
  contracts      Contract[]
  settlements    Settlement[]
  payments       Payment[]
  esfInvoices    EsfInvoice[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           UserRole @default(MANAGER)
  organizationId String?
  positionId     String?
  avatarUrl      String?
  backgroundId   String?
  backgroundImageUrl String?
  backgroundFilter   Json?
  backgroundImageScope String? // 'right' | 'left' | 'all' | 'split' — where backgroundImageUrl (+ sidebarImageUrl for 'split') renders
  sidebarBackgroundId  String?
  sidebarImageUrl      String?
  sidebarImageFilter   Json?
  createdAt      DateTime @default(now())

  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  position         Position?         @relation(fields: [positionId], references: [id], onDelete: SetNull)
  createdDocuments Document[]        @relation("DocumentCreatedBy")
  versions         DocumentVersion[]
  fileAssets       FileAsset[]
  refreshTokens    RefreshToken[]
  completedSteps   SettlementStep[]
  payments         Payment[]

  @@index([organizationId])
  @@index([positionId])
}

model Position {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  permissions    String[] @default([])
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@index([organizationId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Counterparty {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  inn            String?
  bin            String?
  address        String?
  phone          String?
  email          String?
  bankAccount    String?
  bankName       String?
  bankBik        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    Document[]
  contracts    Contract[]
  settlements  Settlement[]
  payments     Payment[]
  esfInvoices  EsfInvoice[]

  @@index([organizationId])
  @@index([organizationId, inn])
}

model Document {
  id             String         @id @default(cuid())
  organizationId String
  type           DocumentType
  status         DocumentStatus @default(DRAFT)
  title          String
  number         String?
  counterpartyId String?
  categoryId     String?
  meta           Json           @default("{}")
  bodyJson       Json           @default("{}")
  isArchived     Boolean        @default(false)
  settlementId   String?
  // Скан подписанного документа ссылается на исходный документ, который подписали.
  sourceDocumentId String?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  counterparty Counterparty?     @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  category     DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy    User              @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  settlement   Settlement?       @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  sourceDocument Document?       @relation("DocumentScanOf", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  scans        Document[]        @relation("DocumentScanOf")
  contract     Contract?         @relation("ContractDocument")
  steps        SettlementStep[]
  versions     DocumentVersion[]
  changes      DocumentChange[]
  fileAssets   FileAsset[]

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([categoryId])
  @@index([settlementId])
  @@index([sourceDocumentId])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  version     Int
  bodyJson    Json
  createdById String
  createdAt   DateTime @default(now())

  document  Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User             @relation(fields: [createdById], references: [id])
  changes   DocumentChange[]

  @@unique([documentId, version])
  @@index([documentId])
}

model DocumentChange {
  id         String       @id @default(cuid())
  documentId String
  versionId  String
  type       ChangeType
  author     ChangeAuthor
  status     ChangeStatus @default(PENDING)
  from       Int
  to         Int
  content    String
  createdAt  DateTime     @default(now())

  document Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version  DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([versionId])
  @@index([documentId, status])
}

model FileAsset {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String?
  settlementId   String?
  originalName   String
  mimeType       String
  size           Int
  s3Key          String   @unique
  s3Url          String
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  settlement   Settlement?      @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  createdBy    User             @relation(fields: [createdById], references: [id])
  steps        SettlementStep[]
  payments     Payment[]
  esfInvoice   EsfInvoice?

  @@index([organizationId])
  @@index([documentId])
  @@index([settlementId])
}

model CompanySettings {
  id             String  @id @default(cuid())
  organizationId String  @unique
  name           String
  inn            String
  bin            String?
  address        String
  phone          String?
  email          String?
  bankAccount    String?
  bankName       String?
  bankBik        String?
  vatRate        Float   @default(12)
  currency       String  @default("KGS")
  logoAssetId    String?
  logoUrl        String?

  // Сквозная нумерация автоматически генерируемых документов.
  // Счётчик сбрасывается при смене года.
  actPrefix          String @default("АВР")
  actCounter         Int    @default(0)
  actCounterYear     Int?
  invoicePrefix      String @default("СЧ")
  invoiceCounter     Int    @default(0)
  invoiceCounterYear Int?

  // Кабинет ЭСФ (esf.salyk.kg). Пароль хранится зашифрованным ключом из
  // окружения и никогда не отдаётся наружу.
  esfLogin         String?
  esfPasswordEnc   String?
  esfLastSyncAt    DateTime?
  esfLastSyncError String?
  /// PIN на просмотр скрытых ЭСФ — argon2-хэш
  esfHiddenPinHash String?

  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model DocumentTemplate {
  id             String       @id @default(cuid())
  organizationId String
  type           DocumentType
  categoryId     String?
  name           String
  description    String?
  bodyJson       Json         @default("{}")
  metaDefaults   Json         @default("{}")
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([categoryId])
}

model Letterhead {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  bodyJson       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model DocumentCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  shortLabel     String
  color          String
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    Document[]
  templates    DocumentTemplate[]

  @@index([organizationId])
}

// ─── Расчёты по месяцам ──────────────────────────────────────────────────────

/// Договор как бизнес-объект: с кем, на сколько, с какой периодичностью.
/// Текст договора — отдельный Document типа CONTRACT, ссылка опциональна.
model Contract {
  id             String  @id @default(cuid())
  organizationId String
  counterpartyId String
  documentId     String? @unique

  title          String
  defaultAmount  Decimal  @db.Decimal(14, 2)
  vatRate        Float    @default(12)
  currency       String   @default("KGS")
  /// День месяца (1–28), когда создаётся расчёт за этот месяц.
  billingDay     Int      @default(1)
  /// Срок оплаты в днях от конца расчётного месяца.
  paymentDueDays Int      @default(10)
  esfRequired    Boolean  @default(true)
  active         Boolean  @default(true)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  document     Document?    @relation("ContractDocument", fields: [documentId], references: [id], onDelete: SetNull)
  settlements  Settlement[]

  @@index([organizationId])
  @@index([organizationId, active])
  @@index([counterpartyId])
}

/// Расчёт за один месяц по одному договору.
/// Статус не хранится — выводится из шагов и платежей.
model Settlement {
  id             String @id @default(cuid())
  organizationId String
  contractId     String
  counterpartyId String

  year      Int
  month     Int
  amount    Decimal @db.Decimal(14, 2)
  vatAmount Decimal @default(0) @db.Decimal(14, 2)
  currency  String  @default("KGS")

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract     Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  counterparty Counterparty     @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  steps        SettlementStep[]
  documents    Document[]
  payments     Payment[]
  fileAssets   FileAsset[]
  esfInvoices  EsfInvoice[]

  @@unique([contractId, year, month])
  @@index([organizationId, year, month])
  @@index([counterpartyId])
}

/// Шаг чек-листа. Закрытый шаг несёт доказательство: документ, файл или платёж.
model SettlementStep {
  id           String             @id @default(cuid())
  settlementId String
  type         SettlementStepType
  order        Int
  dueDate      DateTime?
  doneAt       DateTime?
  doneById     String?
  documentId   String?
  fileAssetId  String?
  paymentId    String?
  note         String?
  createdAt    DateTime           @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  doneBy     User?      @relation(fields: [doneById], references: [id], onDelete: SetNull)
  document   Document?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  fileAsset  FileAsset? @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  payment    Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([settlementId, type])
  @@index([settlementId])
  @@index([dueDate])
}

/// Подтверждение оплаты. Несколько записей на расчёт = частичная оплата.
model Payment {
  id             String  @id @default(cuid())
  organizationId String
  counterpartyId String
  settlementId   String?

  amount      Decimal  @db.Decimal(14, 2)
  paidAt      DateTime
  reference   String?
  fileAssetId String?
  createdById String
  createdAt   DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  counterparty Counterparty     @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  settlement   Settlement?      @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  fileAsset    FileAsset?       @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  createdBy    User             @relation(fields: [createdById], references: [id])
  steps        SettlementStep[]

  @@index([organizationId])
  @@index([settlementId])
  @@index([counterpartyId])
}

/// Статус ЭСФ на портале. Шаг «Выставить ЭСФ» закрывают только SENT и ACCEPTED.
enum EsfStatus {
  NEW
  SENT
  ACCEPTED
  REVOKED
  REJECTED
  UNKNOWN
}

/// ЭСФ, вытянутая из кабинета esf.salyk.kg. Хранится всегда — даже без
/// сопоставленного расчёта, чтобы ничего не терялось и можно было привязать руками.
model EsfInvoice {
  id             String    @id @default(cuid())
  organizationId String
  /// documentUUID на портале — по нему же скачивается публичный PDF
  uuid           String    @unique
  number         String?
  status         EsfStatus @default(UNKNOWN)
  createdOn      DateTime?
  deliveryDate   DateTime?
  issuedOn       DateTime?
  buyerInn       String?
  buyerName      String
  amount         Decimal   @db.Decimal(14, 2)
  /// «Номер учётной системы» — сюда партнёр может вписать наш номер акта
  crmRef         String?
  note           String?

  counterpartyId String?
  settlementId   String?
  fileAssetId    String?   @unique
  /// Почему не сопоставлено — показывается менеджеру
  matchNote      String?
  /// Скрыта менеджером из «без расчёта»: не наша, розница и т.п. Автоподбор её не трогает.
  hiddenAt       DateTime?

  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  settlement   Settlement?   @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  fileAsset    FileAsset?    @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, settlementId])
  @@index([counterpartyId])
}
